    <h3 class="text-xl font-bold">
     Have Questions?
    </h3>
    <form class="bg-gray-800 p-6 rounded-lg mt-4">
     <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input class="p-2 rounded-lg bg-gray-700 text-white" placeholder="Your Name" type="text"/>
      <input class="p-2 rounded-lg bg-gray-700 text-white" placeholder="Your Email" type="email"/>
     </div>
     <textarea class="p-2 rounded-lg bg-gray-700 text-white mt-4 w-full" placeholder="Your Message"></textarea>
     <button class="bg-blue-500 text-white px-4 py-2 rounded-full mt-4">
      Send Message
     </button>
    </form>
   </section>
  </main>
