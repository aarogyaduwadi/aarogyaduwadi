     </p>
     
    </div>
   </section>
   <section class="mt-8">
    <h3 class="text-xl font-bold">
     Photos
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">
     <div class="bg-gray-800 p-4 rounded-lg">
      <img alt="Project screenshot" class="rounded-lg" height="50" src="aarogya photo.png" width="300"/>
     </div>
     <div class="bg-gray-800 p-4 rounded-lg">
      <img alt="Project screenshot" class="rounded-lg" height="200" src="pokhara.JPEG" width="300"/>
    
     </div>
